<?xml version="1.0"?>
<!-- 只用于"出 Nav2 地图"的取证世界：带围挡的场地 + 一台 0.01 m/px 的正俯视相机。
     用法: gz sim -s -r --headless-rendering worlds/nav_map_capture.sdf
     相机在 (0,0,20) 正下方看，hfov 0.7610 rad、1600x1100 → 地面分辨率 0.01 m/px。
     为什么 0.01 m/px：Nav2 地图要 0.02 m/px，渲染分辨率取 2x 才能把围挡（5 cm = 5 px）
     和场地边界分清楚；地图本身是**按图纸几何**生成的，渲染图只做独立校核。 -->
<sdf version="1.9">
  <world name="rmul2027_3v3">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.020 0.023 0.032 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <direction>-0.25 0.30 -0.92</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.60 0.62 0.68 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.60 -0.40 -0.70</direction>
    </light>

    <model name="site_ground">
      <static>true</static>
      <pose>0 0 -0.503 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material><ambient>0.08 0.085 0.10 1</ambient><diffuse>0.08 0.085 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rmul2027_3v3_field</uri>
      <name>rmul2027_3v3_field</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://rmul2027_3v3_fence</uri>
      <name>rmul2027_3v3_fence</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- 正俯视相机：光轴朝下，图像列 = 世界 +X，图像行向下 = 世界 -Y。
         f = (W/2)/tan(hfov/2) = 800/tan(0.3805) = 2000 px
         地面上 1 px = 20 m / 2000 px = 0.01 m。 -->
    <model name="nav_topdown_cam">
      <static>true</static>
      <pose>0 0 20 0 1.5707963 1.5707963</pose>
      <link name="cam_link">
        <sensor name="nav_topdown" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>nav_topdown/image</topic>
          <camera name="nav_topdown">
            <horizontal_fov>0.7610</horizontal_fov>
            <image><width>1600</width><height>1100</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>