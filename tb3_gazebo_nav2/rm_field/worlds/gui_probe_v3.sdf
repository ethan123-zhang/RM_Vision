<?xml version="1.0"?>
<!-- GUI 观感实验 v3：目标"四档可分辨"——天空 < 地面 < 侧壁 < 台面，每档至少差 25。
     - 主光偏顶光（台面亮），补光从 -x/+y 打，让背光侧壁也亮起来
     - 地面中灰偏冷，天空偏暗
     - 相机在 +y 侧，正好能看到台子投在地面上的影子
     用法: gz sim -s -r --headless-rendering worlds/gui_probe_v3.sdf -->
<sdf version="1.9">
  <world name="rmul2027_3v3">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.05 0.06 0.08 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.90 0.90 0.90 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.25 0.30 -0.92</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.60 0.62 0.68 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.60 -0.40 -0.70</direction>
    </light>

    <model name="site_ground">
      <static>true</static>
      <pose>0 0 -0.503 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.08 0.085 0.10 1</ambient><diffuse>0.08 0.085 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rmul2027_3v3_field</uri>
      <name>rmul2027_3v3_field</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- 相机放在 +y 侧：台子的影子（主光把影子投向 -x/+y）落在近处地面上 -->
    <model name="cam_sunny_cam">
      <static>true</static>
      <pose>-8.5 7.5 2.6 0 0.226 -0.723</pose>
      <link name="cam_link">
        <sensor name="cam_sunny" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>cam_sunny/image</topic>
          <camera name="cam_sunny">
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1000</width><height>845</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- 对照：原视角（-y 侧） -->
    <model name="cam_shady_cam">
      <static>true</static>
      <pose>-9.0 -7.5 2.6 0 0.2225 0.6947</pose>
      <link name="cam_link">
        <sensor name="cam_shady" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>cam_shady/image</topic>
          <camera name="cam_shady">
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1000</width><height>845</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>