<?xml version="1.0"?>
<!-- 只看不动的取证世界：把原始（未配色）场地模型从下方仰视，看背面到底是什么
     用法: gz sim -s -r --headless-rendering worlds/preview_back_side.sdf -->
<sdf version="1.9">
  <world name="backside">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.03 0.035 0.05 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <direction>-0.25 0.30 0.92</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <direction>0.5 -0.3 0.8</direction>
    </light>

    <include>
      <uri>model://rmul2027_3v3_field</uri>
      <name>rmul2027_3v3_field</name>
      <static>true</static>
    </include>

    <model name="back_view_cam">
      <static>true</static>
      <pose>-7.0 -7.0 -2.6 0 -0.28 0.785</pose>
      <link name="cam_link">
        <sensor name="back_view" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>back_view/image</topic>
          <camera name="back_view">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1400</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>