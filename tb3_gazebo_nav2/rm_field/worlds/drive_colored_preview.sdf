<?xml version="1.0"?>
<!-- drive_colored.sdf 的"出图版"：模型与颜色完全相同，只多几台相机 + Sensors 系统，
     用于 headless 截图核对（GUI 世界本身不带相机，省 CPU）。
     用法: gz sim -s -r --headless-rendering worlds/drive_colored_preview.sdf -->
<sdf version="1.9">
  <world name="drive">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.42 0.42 0.44 1</ambient>
      <background>0.03 0.035 0.05 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.25 0.30 -0.92</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.57 0.62 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.60 -0.40 -0.70</direction>
    </light>

    <model name="site_ground">
      <static>true</static>
      <pose>0 0 -0.10 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.08 0.08 0.09 1</ambient>
            <diffuse>0.12 0.12 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rmul2027_3v3_field_up</uri>
      <name>rmul2027_3v3_field_up</name>
      <static>true</static>
    </include>

    <!-- 与 config/gui_drive.config 的相机位姿一致 -->
    <model name="hero_cam">
      <static>true</static>
      <pose>-9.0 8.0 4.0 0 0.32 -0.727</pose>
      <link name="cam_link">
        <sensor name="hero" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>hero/image</topic>
          <camera name="hero">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1600</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="view_top_cam">
      <static>true</static>
      <pose>0 0 20 0 1.5707963 0</pose>
      <link name="cam_link">
        <sensor name="view_top" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>view_top/image</topic>
          <camera name="view_top">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1200</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="view_under_cam">
      <static>true</static>
      <pose>-8.0 -8.0 -1.5 0 -0.132 0.785</pose>
      <link name="cam_link">
        <sensor name="view_under" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>view_under/image</topic>
          <camera name="view_under">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1200</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>