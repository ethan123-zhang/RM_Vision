<?xml version="1.0"?>
<!-- GUI 观感实验 v2：同一套几何，改"灯光 + 地面 + 背景"，
     目标让人眼读出"这是一块 0.503 m 高、落在某一层地面上的台子"。
     两台相机：gui_view（现用视角 -9 -7.5 2.6）、gui_view_shadow（-8.5 +7.5 2.6，能看到投影）。
     用法: gz sim -s -r --headless-rendering worlds/gui_probe_v2.sdf -->
<sdf version="1.9">
  <world name="rmul2027_3v3">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <!-- 天空压到明显比地面暗：地平线出现，空间感才出来 -->
      <background>0.05 0.06 0.08 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>
    <!-- 补光：把主光打不到的 -X / +Y 侧壁也照亮，避免"一侧黑成背景" -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.36 0.40 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.6 -0.4 -0.7</direction>
    </light>

    <model name="site_ground">
      <static>true</static>
      <pose>0 0 -0.503 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <!-- 地面提到"中灰"：和天空(暗)、台面(亮)都拉开，台子的落差才有参照 -->
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.12 0.12 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rmul2027_3v3_field</uri>
      <name>rmul2027_3v3_field</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <model name="gui_view_cam">
      <static>true</static>
      <pose>-9.0 -7.5 2.6 0 0.2225 0.6947</pose>
      <link name="cam_link">
        <sensor name="gui_view" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>gui_view/image</topic>
          <camera name="gui_view">
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1000</width><height>845</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="gui_view_shadow_cam">
      <static>true</static>
      <pose>-8.5 7.5 2.6 0 0.226 -0.723</pose>
      <link name="cam_link">
        <sensor name="gui_view_shadow" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>gui_view_shadow/image</topic>
          <camera name="gui_view_shadow">
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1000</width><height>845</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>