<?xml version="1.0"?>
<!-- GUI 观感实验世界：和 rmul2027_3v3_field.sdf 同一套几何，只换配色/补光，
     加一台与 GUI 视角相同的相机（-9 -7.5 2.6，hfov 1.2，1000x845），
     用来在不动 GUI 的前提下复现"人眼到底看到什么"。
     用法: gz sim -s -r --headless-rendering worlds/gui_probe.sdf -->
<sdf version="1.9">
  <world name="rmul2027_3v3">
    <physics name="dartsim-1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.02 0.02 0.025 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <model name="site_ground">
      <static>true</static>
      <pose>0 0 -0.503 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.03 0.035 0.04 1</ambient><diffuse>0.03 0.035 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rmul2027_3v3_field</uri>
      <name>rmul2027_3v3_field</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- 与 config/gui_field.config 的 camera_pose 完全一致 -->
    <model name="gui_view_cam">
      <static>true</static>
      <pose>-9.0 -7.5 2.6 0 0.2225 0.6947</pose>
      <link name="cam_link">
        <sensor name="gui_view" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>gui_view/image</topic>
          <camera name="gui_view">
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1000</width><height>845</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>