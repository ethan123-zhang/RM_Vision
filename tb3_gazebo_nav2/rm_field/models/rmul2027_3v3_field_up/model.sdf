<?xml version="1.0"?>
<!-- RMUL2027 3V3 场地（上下翻转版，结构面朝上）
       浅灰 = 场地地面（z = 0，机器人开在这里）
       绿色 = 内部凸起结构（抬高 0.19 / 0.37 m 的平台与筋）
       红色 = 外围墙墙体（一圈，到 +0.40 m）
       黄色 = 外围墙顶沿
     翻转规则见 debug/make_flipped_meshes.py：z -> -z，再整体 -0.10 m。
     碰撞：地面用 box（顶面 z=0），凸起结构用高度图生成的 box 拼块
           （debug/make_box_collisions.py，48 块；不用三角网格，见文件内 2026-11-19 说明）。 -->
<sdf version="1.9">
  <model name="rmul2027_3v3_field_up">
    <static>true</static>
    <link name="field_link">
      <collision name="floor_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>12.6 8.6 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 碰撞：地面用 box（顶面 z=0），凸起结构用 **box 拼块**。
           2026-11-19 曾用 113,080 面三角网格 structures.stl 做碰撞，机器人被垫高 6 mm
           （z=0.0158 而不是 0.0100）、轮子空转车不走 ⇒ 改成本节由
           debug/make_box_collisions.py 从网格生成的高度图 box 拼块。
           证据见 docs/handoffs/2026-11-19-3v3-field-flip-and-colors.md -->

