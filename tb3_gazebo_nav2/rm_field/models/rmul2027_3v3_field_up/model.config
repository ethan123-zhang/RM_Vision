<?xml version="1.0"?>
<model>
  <name>rmul2027_3v3_field_up</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>lead</author>
  <description>RMUL2027 3V3 场地（按用户要求上下翻转，结构面朝上）：
  平整面作为场地地面落在 z=0，凸起结构最高 +0.40 m，台体底板到 -0.10 m。
  几何与 rmul2027_3v3_field 是同一份网格，只做了 z -> -z 翻转，顶点数不变。</description>
</model>