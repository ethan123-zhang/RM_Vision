<?xml version="1.0"?>
<!-- RMUL 2027 3V3 场地：视觉=CAD 网格（Z-up 米制，台面 z=0），碰撞=等效 box。
     尺寸来自 3D_CAD_Model/RMUL2027_3V3_V1.0.0.stp 的实测包围盒：
       X 12.600 m  Y 8.600 m  Z 0.503 m（台面在模型 y=+0.100 m，已平移到 z=0） -->
<sdf version="1.9">
  <model name="rmul2027_3v3_field">
    <static>true</static>
    <link name="field_link">
      <collision name="field_collision">
        <!-- 碰撞体故意用 box：12.6 x 8.6 的台面 + 0.503 m 的结构厚度，
             顶面正好 z=0。直接用 15 万面片的 CAD 网格做碰撞会拖慢物理且易抖动。 -->
        <pose>0 0 -0.2515 0 0 0</pose>
        <geometry>
          <box>
            <size>12.6 8.6 0.503</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1e6</threshold>
          </bounce>
        </surface>
      </collision>

      <visual name="field_visual">
        <geometry>
          <mesh>
            <uri>model://rmul2027_3v3_field/meshes/field_zup.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.30 0.32 0.35 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>