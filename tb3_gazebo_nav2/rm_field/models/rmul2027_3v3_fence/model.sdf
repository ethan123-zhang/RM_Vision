<?xml version="1.0"?>
<!-- RMUL2027 3V3 场地围挡：踩在台面边缘内侧的一圈 0.30 m 高墙 + 红色顶沿。
     场地台面 z=0，尺寸 12.6 x 8.6 m；围挡 5 cm 厚、30 cm 高，带碰撞（机器人撞不出去）。
     世界里的用法见 worlds/rmul2027_3v3_field_fenced.sdf。 -->
<sdf version="1.9">
  <model name="rmul2027_3v3_fence">
    <static>true</static>
    <link name="south_link">
      <pose>0 -4.275 0.15 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>12.65 0.05 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>12.65 0.05 0.30</size></box></geometry>
        <material><ambient>0.60 0.60 0.62 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material>
      </visual>
    </link>
    <link name="north_link">
      <pose>0 4.275 0.15 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>12.65 0.05 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>12.65 0.05 0.30</size></box></geometry>
        <material><ambient>0.60 0.60 0.62 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material>
      </visual>
    </link>
    <link name="west_link">
      <pose>-6.275 0 0.15 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 8.6 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 8.6 0.30</size></box></geometry>
        <material><ambient>0.60 0.60 0.62 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material>
      </visual>
    </link>
    <link name="east_link">
      <pose>6.275 0 0.15 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 8.6 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 8.6 0.30</size></box></geometry>
        <material><ambient>0.60 0.60 0.62 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material>
      </visual>
    </link>
    <!-- 红色顶沿：让"墙顶"这条线在画面里特别清楚，高度一眼可判 -->
    <link name="south_rail">
      <pose>0 -4.275 0.31 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>12.66 0.07 0.04</size></box></geometry>
        <material><ambient>0.55 0.10 0.10 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="north_rail">
      <pose>0 4.275 0.31 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>12.66 0.07 0.04</size></box></geometry>
        <material><ambient>0.55 0.10 0.10 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="west_rail">
      <pose>-6.275 0 0.31 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.07 8.6 0.04</size></box></geometry>
        <material><ambient>0.55 0.10 0.10 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="east_rail">
      <pose>6.275 0 0.31 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.07 8.6 0.04</size></box></geometry>
        <material><ambient>0.55 0.10 0.10 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>