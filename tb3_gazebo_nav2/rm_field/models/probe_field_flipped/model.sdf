<?xml version="1.0"?>
<!-- 验证朝向：翻转后的场地模型（z=0 现在是底面，结构朝上） -->
<sdf version="1.9">
  <model name="probe_field_flipped">
    <static>true</static>
    <link name="field_link">
      <collision name="field_collision">
        <pose>0 0 0.2515 0 0 0</pose>
        <geometry>
          <box>
            <size>12.6 8.6 0.503</size>
          </box>
        </geometry>
      </collision>
      <visual name="field_visual">
        <geometry>
          <mesh>
            <uri>model://probe_field_flipped/meshes/field_flipped.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.47 1</ambient>
          <diffuse>0.72 0.72 0.75 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>