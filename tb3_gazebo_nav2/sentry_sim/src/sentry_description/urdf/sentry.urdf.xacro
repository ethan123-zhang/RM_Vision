<?xml version="1.0"?>
<robot name="sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find livox_gz_sim)/urdf/mid360.xacro"/>

  <!-- lidar render cost knobs (llvmpipe: keep the rendered image small) -->
  <xacro:arg name="lidar_slices" default="1"/>
  <xacro:arg name="lidar_resolution" default="1.0"/>

  <xacro:property name="base_x" value="0.50"/>
  <xacro:property name="base_y" value="0.50"/>
  <xacro:property name="base_z_size" value="0.12"/>
  <xacro:property name="base_mass" value="20.0"/>

  <xacro:property name="wheel_r" value="0.075"/>
  <xacro:property name="wheel_w" value="0.045"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="wheel_sep" value="0.40"/>
  <xacro:property name="wheelbase" value="0.40"/>

  <!-- Mecanum rollers: 12 per wheel as passive revolute links, roller axis 45 deg to the
       wheel axis, outer radius = wheel_r. A welded roller cannot roll, so the contact
       would not slide along the 45 deg line and lateral / yaw commands would stall;
       mirror=-1/1 selects the two roller handwheels (FL & RR one type, FR & RL the other). -->
  <xacro:property name="roller_n" value="12"/>
  <xacro:property name="roller_r" value="0.016"/>
  <xacro:property name="roller_len" value="0.050"/>
  <xacro:property name="roller_rim" value="${wheel_r - roller_r}"/>
  <xacro:property name="roller_mass" value="0.005"/>
  <xacro:property name="hub_r" value="0.045"/>

  <!-- base_link centre above ground: chassis bottom 0.03 m, wheel centre 0.075 m -->
  <xacro:property name="base_height" value="0.09"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_y*base_y + base_z_size*base_z_size) / 12.0}"
        iyy="${base_mass * (base_x*base_x + base_z_size*base_z_size) / 12.0}"
        izz="${base_mass * (base_x*base_x + base_y*base_y) / 12.0}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z_size}"/></geometry>
      <material name="sentry_grey"><color rgba="0.28 0.31 0.34 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z_size}"/></geometry>
      <surface>
        <friction>
          <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
        </friction>
      </surface>
    </collision>
  </link>

  <xacro:macro name="roller" params="wheel i mirror">
    <xacro:property name="theta" value="${2.0*pi*i/roller_n}"/>
    <link name="${wheel}_roller_${i}_link">
      <inertial>
        <mass value="${roller_mass}"/>
        <inertia
          ixx="${roller_mass * (3.0*roller_r*roller_r + roller_len*roller_len) / 12.0}"
          iyy="${roller_mass * (3.0*roller_r*roller_r + roller_len*roller_len) / 12.0}"
          izz="${roller_mass * roller_r * roller_r / 2.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="${roller_r}" length="${roller_len}"/></geometry>
        <material name="roller_rubber"><color rgba="0.16 0.16 0.17 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${roller_r}" length="${roller_len}"/></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="${wheel}_roller_${i}_joint" type="continuous">
      <parent link="${wheel}_wheel_link"/>
      <child link="${wheel}_roller_${i}_link"/>
      <origin xyz="${roller_rim*cos(theta)} 0 ${roller_rim*sin(theta)}"
              rpy="${mirror*pi/4.0} ${-theta} 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.0005" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mecanum_wheel" params="name x y mirror">
    <link name="${name}_wheel_link">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3.0*wheel_r*wheel_r + wheel_w*wheel_w) / 12.0}"
          iyy="${wheel_mass * wheel_r * wheel_r / 2.0}"
          izz="${wheel_mass * (3.0*wheel_r*wheel_r + wheel_w*wheel_w) / 12.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual name="hub">
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${hub_r}" length="${wheel_w}"/></geometry>
        <material name="wheel_hub"><color rgba="0.55 0.57 0.60 1.0"/></material>
      </visual>
      <collision name="hub">
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${hub_r}" length="${wheel_w}"/></geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_r - base_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <xacro:roller wheel="${name}" i="0" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="1" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="2" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="3" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="4" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="5" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="6" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="7" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="8" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="9" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="10" mirror="${mirror}"/>
    <xacro:roller wheel="${name}" i="11" mirror="${mirror}"/>
  </xacro:macro>

  <xacro:mecanum_wheel name="front_left"  x="${ wheelbase/2.0}" y="${ wheel_sep/2.0}" mirror="1"/>
  <xacro:mecanum_wheel name="front_right" x="${ wheelbase/2.0}" y="${-wheel_sep/2.0}" mirror="-1"/>
  <xacro:mecanum_wheel name="back_left"   x="${-wheelbase/2.0}" y="${ wheel_sep/2.0}" mirror="-1"/>
  <xacro:mecanum_wheel name="back_right"  x="${-wheelbase/2.0}" y="${-wheel_sep/2.0}" mirror="1"/>

  <xacro:mid360 parent="base_link" name="livox"
                slices="$(arg lidar_slices)"
                resolution="$(arg lidar_resolution)">
    <origin xyz="0.05 0 0.30" rpy="0 0 0"/>
  </xacro:mid360>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>back_left_wheel_joint</back_left_joint>
      <back_right_joint>back_right_wheel_joint</back_right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheelbase>${wheelbase}</wheelbase>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_velocity>1.2</max_velocity>
      <max_acceleration>2.5</max_acceleration>
      <!-- no max_jerk: gz SpeedLimiter with a jerk limit overshoots through zero on stop -->
      <topic>/cmd_vel</topic>
      <odom_topic>/mecanum_odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <!-- S1b: second odometry publisher = ground truth in the map frame.
         For this field the gz world frame and the map frame coincide, so the
         model pose is map_T_base. odin1_sim_bridge needs both this and /odom
         to build map -> odom. The plugin reports the model pose relative to
         the world origin (verified: spawn_x:=1.0 -> x = 1.0). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odometry_frame>map</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/gt_odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
</robot>