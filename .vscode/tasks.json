{
  // VS Code 里编译 C 板底盘工程；烧写在 Keil 界面按 F8（本机唯一可靠路径）
  // Ctrl+Shift+B = 默认任务（编译）
  // 命令面板 -> Tasks: Run Task -> 选其余任务
  //
  // 为什么不在 VS Code 里直接烧：
  //   本机 Keil 是破解版，UV4 -f 批处理必崩（0xC0000409）；
  //   STM32CubeProgrammer 在本机与 ST-Link 不兼容 —— 两者都别用。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "底盘: 编译",
      "detail": "UV4 -b，等价 Keil 按 F7",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-File",
        "${workspaceFolder}/cboard_chassis/tools/flash.ps1",
        "-BuildOnly"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "底盘: 编译并打开 Keil 烧写",
      "detail": "编译后打开 Keil 工程，按 F8 烧写",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-File",
        "${workspaceFolder}/cboard_chassis/tools/flash.ps1"
      ],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "底盘: 只打开 Keil 工程",
      "detail": "不编译，直接打开 Keil 按 F8",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-File",
        "${workspaceFolder}/cboard_chassis/tools/flash.ps1",
        "-OpenOnly"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
