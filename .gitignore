# ---- 密钥与本地配置 ----
.env
*.env
*.key
*.pem
secrets/

# ---- 缓存与编辑器 ----
__pycache__/
*.py[cod]
.venv/
venv/
# .vscode 整体忽略，但保留团队共用的任务配置（编译/下载）
.vscode/*
!.vscode/tasks.json
.idea/
Thumbs.db
.DS_Store
