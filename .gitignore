# ---- 大型二进制 / 系统镜像 ----
*.img
*.iso

# ---- 模型与权重（记录导出方式，不入库）----
*.onnx
*.pt
*.pth
*.rknn
*.kmodel
*.hbm
*.engine
*.bin

# ---- 本地实验素材（不入库）----
_probe/
_downloads/

# ---- 板端部署包与采集产物（可重新生成）----
x5_odin/odin_deploy.zip
x5_odin/capture/
