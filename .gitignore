# ---- 大型二进制 / 系统镜像 ----
*.img
*.iso

# ---- 模型与权重（记录导出方式，不入库）----
*.onnx
*.pt
*.pth
*.rknn
*.kmodel
*.hbm
*.engine
*.bin

# ---- 本地实验素材（不入库）----
_probe/
_downloads/

# ---- 板端部署包与采集产物（可重新生成）----
x5_odin/odin_deploy.zip
x5_odin/capture/
x5_odin/*.log

# ---- 密钥与本地配置 ----
.env
*.env
*.key
*.pem
secrets/

# ---- 厂商资料 / 第三方示例（不入库，可自行下载）----
Development-Board-C-Examples-master/
# Keil DFP 器件包（随 Keil 安装，几十 MB）
**/.pack/

# ---- 本地 Agent / 编辑器状态（不上传）----
.dsh/
.obsidian/

# ---- 板端运行日志副本（可重新生成，分析结论见 docs/experiments）----
car_slam_lap/demo/**/*.log

# ---- 缓存与编辑器 ----
__pycache__/
*.py[cod]
.venv/
venv/
# .vscode 整体忽略，但保留团队共用的任务配置（编译/下载）
.vscode/*
!.vscode/tasks.json
.idea/
Thumbs.db
.DS_Store

# ---- Gazebo 仿真（tb3_gazebo_nav2）：可重新生成的大文件与调试产物 ----
tb3_gazebo_nav2/**/*.stl
tb3_gazebo_nav2/**/build/
tb3_gazebo_nav2/logs/
tb3_gazebo_nav2/rm_field/logs/
# 围栏验收每次重跑都会重写这批探针 SDF，可再生成
tb3_gazebo_nav2/rm_field/results/probe_sdf/
# rm_field/shots 只保留证据图，其余调试截图不入库
tb3_gazebo_nav2/rm_field/shots/*.png
!tb3_gazebo_nav2/rm_field/shots/height_*.png
!tb3_gazebo_nav2/rm_field/shots/gui_fenced_view*.png
!tb3_gazebo_nav2/rm_field/shots/nav_topdown.png
!tb3_gazebo_nav2/rm_field/shots/nav_map_overlay.png
